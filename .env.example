# ReceiptLens environment template
# Copy to .env and fill in. NEVER commit real .env contents.
# Generated 2026-08-11 — see README.md and docs/ for details.

# --- Core ---
# SQLite database path for the product service (default: in-memory)
RECEIPTLENS_PRODUCT_DB=./receiptlens-product.db

# Comma-separated trusted frontend origins (CORS)
RECEIPTLENS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- QuickBooks Online (sandbox) ---
# URL-safe Base64 of exactly 32 random bytes — REQUIRED for provider credentials
# generate: python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
RECEIPTLENS_CREDENTIAL_KEY=

# Intuit app client id + redirect URI (optional; unset = OAuth URL built with placeholder)
RECEIPTLENS_QBO_CLIENT_ID=
RECEIPTLENS_QBO_REDIRECT_URI=/product/connections/quickbooks/oauth/callback

# --- Subscription alerts (SMTP) ---
# Set to 1 to allow SMTP delivery of renewal/price-hike alerts
RECEIPTLENS_SMTP_ENABLED=0
